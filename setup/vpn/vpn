#!/bin/bash
#
# vpn — выполняет команду в сетевом неймспейсе, куда целиком отдан физический
#       интерфейс VPN-сети ($IFACE). Весь трафик команды идёт через этот
#       интерфейс и его шлюз, хостовая сеть при этом не затрагивается.
#
# Использование:
#     vpn <команда> [аргументы...]      выполнить команду в неймспейсе
#     MY_VAR=123 vpn bash               окружение пробрасывается внутрь
#     vpn vpn <команда>                 вложенный вызов поддерживается
#     vpn --ensure                      только настроить сеть (идемпотентно)
#     vpn --clean                       снести ns и вернуть интерфейс хосту
#     vpn --status                      показать состояние
#     vpn --check                       показать внешний IP: в текущем ns и через vpn
#     VPN_FORCE=1 vpn --ensure          забрать $IFACE, игнорируя проверку ниже
#     VPN_IDE_LOCK_DIR=... vpn ...      другой каталог lock-файлов IDE
#     VPN_PORTS_FILE=... vpn ...        другой файл со списком портов (см. ниже)
#     VPN_HOSTS_FILE=... vpn ...        другой файл со списком хостов в обход vpn
#
# Скрипт сам уходит в основной ns хоста, если запущен из другого ns (например,
# из 'vpn2' в setup/vpn-via-socks) — оборачивать в no-vpn не нужно.
#
# Предусловие (проверяется перед переносом $IFACE, см. host_uplink_ok):
#   у хоста должен быть default-маршрут через устройство, отличное от $IFACE,
#   и хотя бы один nameserver. Иначе $IFACE — единственный аплинк хоста, и его
#   переезд в ns оставит хост без сети и DNS: NetworkManager уводит вместе с
#   устройством активный профиль и переписывает resolv.conf пустым.
#   Проверке предшествует ограниченное ожидание (HOST_NET_WAIT) — оно нужно лишь
#   для раннего запуска, пока NM не дошёл до хостового интерфейса. Устойчиво
#   сломанную конфигурацию ожиданием не вылечить, поэтому дальше идёт отказ
#   с подсказкой, а не бесконечное ожидание.
#   Перед самым переносом $IFACE отдаётся из-под NM (nmcli device set managed no)
#   — runtime, до перезагрузки. Постоянный конфиг NM намеренно не трогается:
#   схема не должна требовать правки локальных настроек машины.
#
# Архитектура:
#   $IFACE переносится ЦЕЛИКОМ внутрь неймспейса (ip link set ... netns), там ему
#   назначается статический адрес и дефолтный маршрут через VPN-шлюз. На хосте
#   интерфейс при этом исчезает — хостовая маршрутизация не меняется вообще.
#   DNS для ns берётся из /etc/netns/$NS_NAME/resolv.conf: 'ip netns exec'
#   бинд-маунтит файлы оттуда поверх /etc/ в приватном mount-ns команды.
#
#   У ns своя собственная петля: 127.0.0.1 внутри ns — это НЕ хостовый 127.0.0.1,
#   и хостовые сервисы, слушающие только на петле, изнутри ns недоступны.
#
#   Мостик до хостовой петли: JetBrains/VSCode-плагин Claude Code кладёт
#   в $IDE_LOCK_DIR файл вида <порт>.lock на каждый запущенный IDE и слушает этот
#   порт на хостовом 127.0.0.1. Кроме портов IDE пробрасываются порты, перечисленные
#   в $PORTS_FILE (по умолчанию ~/.no-vpn-ports вызвавшего пользователя); нет
#   файла — нет и лишних портов, поведение как раньше. Пробрасываются ТОЛЬКО эти
#   TCP-порты — через veth-пару и две цепочки DNAT (порт сохраняется):
#       ns:   127.0.0.1:<порт>       --DNAT-->  $VETH_HOST_IP:<порт>
#       хост: $VETH_HOST_IP:<порт>   --DNAT-->  127.0.0.1:<порт>
#   Приложение может забиндить исходящий сокет на 127.0.0.1, поэтому в ns есть
#   ещё SNAT на адрес своего конца veth. Хостовой стороне нужен route_localnet=1
#   на veth — иначе ядро дропает 127/8, пришедшее не с lo.
#   Осознанно НЕ пробрасывается вся петля целиком: хостовый 127.0.0.1 — это
#   доверенная зона (там же сидят и отладочные, и служебные сокеты), и открывать
#   её в ns ради пары портов незачем.
#
#   Обход vpn: хосты и адреса из $HOSTS_FILE (по умолчанию ~/.no-vpn-hosts
#   вызвавшего пользователя) достижимы из ns мимо $IFACE — через ту же veth-пару
#   и хостовую маршрутизацию:
#       ns:   маршрут <адрес> via $VETH_HOST_IP (proto $BYPASS_PROTO)
#       хост: FORWARD из veth только на эти адреса + MASQUERADE на выходе
#   Имена резолвятся в ВСЕ IPv4-адреса (getent ahostsv4) дважды — хостовым
#   резолвером и резолвером ns: DNS за VPN и хостовый DNS могут отдавать разные
#   наборы, а приложение в ns спросит именно свой. Резолвинг повторяется на каждом
#   запуске vpn — у долгоживущих процессов при смене адресов нужен 'vpn --ensure'.
#   Только IPv4: у ns нет IPv6-маршрутов, AAAA-адреса отваливаются мгновенно и
#   клиенты уходят на IPv4.
#
# Скрипт идемпотентен: при повторных запусках уже созданный ns и настроенный
# интерфейс обнаруживаются и НЕ пересоздаются. За собой ничего не чистит —
# для сноса есть --clean.
#
set -uo pipefail

# ------------------------------- параметры ----------------------------------
NS_NAME="vpn"
IFACE="ens36"               # физический интерфейс VPN-сети, уезжает внутрь ns
NS_IP="172.16.103.102"
NS_PREFIX="24"
NS_GW="172.16.103.249"

DNS1="8.8.8.8"
DNS2="8.8.4.4"

# --- мостик до хостовой петли для проброшенных портов ---
VETH_HOST="vpn-h"           # хостовый конец veth
VETH_NS="vpn-n"             # конец veth внутри неймспейса
VETH_HOST_IP="10.99.97.1"
VETH_NS_IP="10.99.97.2"
VETH_PREFIX="30"
# Цепочка (одноимённая на хосте и в ns), куда складываются правила на каждый
# найденный порт. Отдельная цепочка нужна ровно затем, чтобы пересинхронизация
# была флешем: набор lock-файлов меняется при каждом перезапуске IDE, и точечно
# доудалять исчезнувшие порты пришлось бы разбором вывода iptables.
# Имя историческое (сначала пробрасывались только порты IDE) — оставлено прежним,
# чтобы --clean снимал цепочку, созданную старой версией скрипта.
PORT_CHAIN="VPN_IDE"
# Каталог с lock-файлами IDE и файл со списком дополнительных портов. Ищутся у
# пользователя, который вызвал vpn, а не у root: под sudo $HOME — это /root.
# Переопределяются через VPN_IDE_LOCK_DIR / VPN_PORTS_FILE.
IDE_LOCK_DIR="${VPN_IDE_LOCK_DIR:-}"
PORTS_FILE="${VPN_PORTS_FILE:-}"

# --- обход vpn для адресов из $HOSTS_FILE ---
HOSTS_FILE="${VPN_HOSTS_FILE:-}"
# Хостовая filter-цепочка: какие адреса ns может достать через хост. Как и
# $PORT_CHAIN, пересобирается целиком на каждом запуске.
BYPASS_CHAIN="VPN_BYPASS"
# Метка (protocol) маршрутов обхода в ns: по ней отличаем свои маршруты от прочих
# и доудаляем исчезнувшие из списка.
BYPASS_PROTO="222"
# Потолок на резолвинг одного имени: при лежащем DNS getent ждёт до 20 секунд.
RESOLVE_TIMEOUT=5

# Спецификации правил вынесены в переменные: одна и та же строка используется
# и для проверки (-C), и для добавления, и для удаления в --clean.
HOST_JUMP_SPEC=(-i "$VETH_HOST" -s "$VETH_NS_IP" -d "$VETH_HOST_IP" -j "$PORT_CHAIN")
NS_JUMP_SPEC=(-d 127.0.0.1/32 -p tcp -j "$PORT_CHAIN")
NS_SNAT_SPEC=(-o "$VETH_NS" -j SNAT --to-source "$VETH_NS_IP")
NS_FWD_DROP_SPEC=(-o "$VETH_NS" -j DROP)
HOST_BYPASS_IN_SPEC=(-i "$VETH_HOST" -j "$BYPASS_CHAIN")
HOST_BYPASS_OUT_SPEC=(-o "$VETH_HOST" -j "$BYPASS_CHAIN")
HOST_MASQ_SPEC=(-s "$VETH_NS_IP/32" ! -o "$VETH_HOST" -j MASQUERADE)

# Сколько секунд ждать готовности хостовой сети перед тем, как забирать $IFACE.
# Нужно только при раннем запуске (сразу после загрузки, пока NM не дошёл до
# хостового интерфейса). Если сеть уже готова — ожидания нет вообще.
HOST_NET_WAIT=30

# --------------------------------- утилиты -----------------------------------
log() { echo "[vpn] $*" >&2; }
die() { echo "[vpn] Ошибка: $*" >&2; exit 1; }
is_root() { [ "$(id -u)" -eq 0 ]; }

# Признак того, что мы УЖЕ внутри неймспейса vpn (важно для вложенных вызовов
# vpn vpn ... — нельзя считать текущий ns корневым).
in_target_ns() {
    [ "$(ip netns identify $$ 2>/dev/null)" = "$NS_NAME" ] && return 0
    # запасной способ: сравнить inode net-ns текущего процесса и named-ns vpn
    if [ -e "/run/netns/$NS_NAME" ]; then
        local a b
        a=$(stat -L -c %i "/proc/self/ns/net" 2>/dev/null)
        b=$(stat -L -c %i "/run/netns/$NS_NAME" 2>/dev/null)
        [ -n "$a" ] && [ "$a" = "$b" ] && return 0
    fi
    return 1
}

ns_usable() { ip netns exec "$NS_NAME" true 2>/dev/null; }
iface_in_ns() { ip netns exec "$NS_NAME" ip link show "$IFACE" >/dev/null 2>&1; }
iface_on_host() { ip link show "$IFACE" >/dev/null 2>&1; }
ns_ipt() { ip netns exec "$NS_NAME" iptables "$@"; }
veth_host_up() { ip link show "$VETH_HOST" >/dev/null 2>&1; }
veth_ns_up() { ip netns exec "$NS_NAME" ip link show "$VETH_NS" >/dev/null 2>&1; }

# Добавить правило, если его ещё нет: "$1" — команда (iptables/ns_ipt),
# "$2" — таблица, "$3" — куда вставлять (-I/-A), "$4" — цепочка, дальше спецификация.
ensure_rule() {
    local cmd="$1" table="$2" op="$3" chain="$4"; shift 4
    "$cmd" -t "$table" -C "$chain" "$@" 2>/dev/null \
        || "$cmd" -t "$table" "$op" "$chain" "$@"
}

# Всё ли уже создано и настроено ранее (вызывать из root). Если да — пропускаем.
# Про конкретные проброшенные порты тут ничего не проверяется: они живут в
# $PORT_CHAIN и пересинхронизируются отдельно на каждом запуске (см. sync_ports).
is_ready() {
    ns_usable || return 1
    iface_in_ns || return 1
    ip netns exec "$NS_NAME" ip -4 addr show dev "$IFACE" 2>/dev/null \
        | grep -qw "$NS_IP/$NS_PREFIX" || return 1
    ip netns exec "$NS_NAME" ip route show default 2>/dev/null \
        | grep -qw "$NS_GW" || return 1
    # мостик до хостовой петли
    veth_host_up || return 1
    veth_ns_up || return 1
    iptables -t nat -n -L "$PORT_CHAIN" >/dev/null 2>&1 || return 1
    ns_ipt -t nat -n -L "$PORT_CHAIN" >/dev/null 2>&1 || return 1
    iptables -t nat -C PREROUTING "${HOST_JUMP_SPEC[@]}" 2>/dev/null || return 1
    ns_ipt -t nat -C OUTPUT "${NS_JUMP_SPEC[@]}" 2>/dev/null || return 1
    ns_ipt -t nat -C POSTROUTING "${NS_SNAT_SPEC[@]}" 2>/dev/null || return 1
    # обход vpn (сами адреса — в sync_bypass)
    iptables -n -L "$BYPASS_CHAIN" >/dev/null 2>&1 || return 1
    iptables -C FORWARD "${HOST_BYPASS_IN_SPEC[@]}" 2>/dev/null || return 1
    iptables -C FORWARD "${HOST_BYPASS_OUT_SPEC[@]}" 2>/dev/null || return 1
    iptables -t nat -C POSTROUTING "${HOST_MASQ_SPEC[@]}" 2>/dev/null || return 1
    return 0
}

# --------------------------- пробрасываемые порты ----------------------------
# Домашний каталог вызвавшего пользователя. Под sudo $HOME указывает на /root,
# поэтому он берётся из passwd по имени исходного пользователя.
caller_home() {
    local u home
    u="${SUDO_USER:-}"
    if [ -z "$u" ] || [ "$u" = "root" ]; then
        u="${USER:-$(id -un)}"
    fi
    home=$(getent passwd "$u" 2>/dev/null | cut -d: -f6)
    printf '%s' "${home:-$HOME}"
}

# Каталог lock-файлов IDE вызвавшего пользователя.
ide_lock_dir() {
    [ -n "$IDE_LOCK_DIR" ] && { printf '%s' "$IDE_LOCK_DIR"; return 0; }
    printf '%s/.claude/ide' "$(caller_home)"
}

# Файл со списком дополнительных портов вызвавшего пользователя.
ports_file() {
    [ -n "$PORTS_FILE" ] && { printf '%s' "$PORTS_FILE"; return 0; }
    printf '%s/.no-vpn-ports' "$(caller_home)"
}

# Файл со списком хостов в обход vpn вызвавшего пользователя.
hosts_file() {
    [ -n "$HOSTS_FILE" ] && { printf '%s' "$HOSTS_FILE"; return 0; }
    printf '%s/.no-vpn-hosts' "$(caller_home)"
}

# Список (по одному элементу в строке) одной строкой для вывода человеку.
fmt_list() {
    local s
    s=$(printf '%s' "$1" | tr '\n' ' ')
    s=${s% }
    printf '%s' "${s:-(нет)}"
}

# Порты из имён файлов <порт>.lock. Содержимое файла не парсится: номер порта
# и есть имя, а json там — про workspace и токен авторизации.
ide_ports() {
    local dir f p
    dir=$(ide_lock_dir)
    [ -d "$dir" ] || return 0
    for f in "$dir"/*.lock; do
        [ -e "$f" ] || continue           # nullglob не включён: пустой каталог
        p=${f##*/}; p=${p%.lock}
        case "$p" in ''|*[!0-9]*) continue ;; esac
        [ "$p" -ge 1 ] 2>/dev/null && [ "$p" -le 65535 ] && printf '%s\n' "$p"
    done
}

# Порты из $(ports_file) — то, что пользователь захотел пробросить сверх IDE.
# Формат намеренно нестрогий: номера портов, разделённые пробелами, переводами
# строки или запятыми; всё после '#' — комментарий. Нет файла — нет и портов
# (поведение ровно как до появления этой возможности).
extra_ports() {
    local file line tok
    file=$(ports_file)
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        line=${line//,/ }
        for tok in $line; do
            case "$tok" in ''|*[!0-9]*) ;;
                *) if [ "$tok" -ge 1 ] 2>/dev/null && [ "$tok" -le 65535 ]; then
                       printf '%s\n' "$tok"
                       continue
                   fi ;;
            esac
            log "пропускаю '$tok' в $file — не похоже на номер порта"
        done
    done < "$file"
}

# Переложить актуальный набор портов в $PORT_CHAIN с обеих сторон мостика.
# Вызывается на КАЖДОМ запуске (в отличие от остальной настройки): IDE при
# перезапуске занимает новый порт и оставляет новый lock-файл, да и список в
# $(ports_file) правится без участия скрипта.
sync_ports() {
    local p ide extra ports
    ide=$(ide_ports)
    extra=$(extra_ports)
    # sort -un заодно снимает дубли, если порт есть и в lock-файлах, и в списке
    ports=$(printf '%s\n%s\n' "$ide" "$extra" | grep . | sort -un | tr '\n' ' ')
    ports=${ports% }
    iptables -t nat -F "$PORT_CHAIN"
    ns_ipt   -t nat -F "$PORT_CHAIN"
    for p in $ports; do
        # ns: на хостовый конец veth; хост: с него на свою настоящую петлю
        ns_ipt   -t nat -A "$PORT_CHAIN" -p tcp --dport "$p" \
            -j DNAT --to-destination "$VETH_HOST_IP:$p"
        iptables -t nat -A "$PORT_CHAIN" -p tcp --dport "$p" \
            -j DNAT --to-destination "127.0.0.1:$p"
    done
    log "порты IDE из $(ide_lock_dir): $(fmt_list "$ide")"
    # про файл со списком молчим, когда его нет: вывод остаётся прежним
    [ -f "$(ports_file)" ] && log "порты из $(ports_file): $(fmt_list "$extra")"
    return 0
}

# ------------------------------ обход vpn -----------------------------------
# IPv4-адрес или сеть a.b.c.d/len (len 1..32: /0 перебил бы default-маршрут ns).
# Ведущие нули не допускаются: ip и iptables по-разному трактуют 010 (октал).
is_ipv4_net() {
    local o='(0|[1-9][0-9]{0,2})'
    [[ $1 =~ ^$o\.$o\.$o\.$o(/([1-9][0-9]?))?$ ]] || return 1
    local i
    for i in 1 2 3 4; do
        [ "${BASH_REMATCH[i]}" -le 255 ] || return 1
    done
    [ -z "${BASH_REMATCH[6]}" ] || [ "${BASH_REMATCH[6]}" -le 32 ]
}

# Все IPv4-адреса имени: объединение ответов хостового резолвера и резолвера ns
# (у ns свой resolv.conf, и DNS за VPN может отдать другой набор). ahostsv4 идёт
# через getaddrinfo, поэтому возвращает все A-записи, а не первую, и учитывает
# /etc/hosts. Loopback отбрасывается: маршрут на него в ns смысла не имеет.
resolve_all() {
    local sudo=()
    is_root || sudo=(sudo)
    {
        timeout "$RESOLVE_TIMEOUT" getent ahostsv4 "$1"
        # нет ns (ещё не создан) — просто нет второго набора
        "${sudo[@]}" timeout "$RESOLVE_TIMEOUT" \
            ip netns exec "$NS_NAME" getent ahostsv4 "$1"
    } 2>/dev/null | awk '$1 !~ /^127\./ {print $1}' \
        | sort -u -t. -k1,1n -k2,2n -k3,3n -k4,4n
}

# Записи из $(hosts_file) — по строке на запись: "<запись> <адрес> <адрес>...".
# У нерезолвящегося имени адресов нет, строка из одного слова. Формат файла тот
# же, что у списка портов: разделители — пробелы, переводы строки, запятые;
# всё после '#' — комментарий. Нет файла — нет и обхода.
bypass_entries() {
    local file line tok ips
    file=$(hosts_file)
    [ -f "$file" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        line=${line//,/ }
        for tok in $line; do
            if is_ipv4_net "$tok"; then
                printf '%s %s\n' "$tok" "${tok%/32}"
                continue
            fi
            case "$tok" in
                *:*) log "пропускаю '$tok' в $file — обход vpn только для IPv4"
                     continue ;;
                *[!A-Za-z0-9._-]*|[.-]*)
                     log "пропускаю '$tok' в $file — не адрес IPv4 и не имя хоста"
                     continue ;;
            esac
            ips=$(resolve_all "$tok" | tr '\n' ' ')
            printf '%s %s\n' "$tok" "${ips% }"
        done
    done < "$file"
}

# Включить IPv4-форвардинг на интерфейсе, если выключен. Ядро смотрит флаг
# ВХОДНОГО интерфейса: для запросов это $VETH_HOST, для ответов — аплинк хоста.
# Runtime, до перезагрузки; обычно уже включено (docker ставит ip_forward=1).
ensure_forwarding() {
    local f="/proc/sys/net/ipv4/conf/$1/forwarding"
    [ -w "$f" ] || return 0
    [ "$(cat "$f")" = "1" ] && return 0
    log "включаю forwarding на $1 (runtime, до перезагрузки)"
    echo 1 > "$f"
}

# Переложить актуальный набор адресов обхода: разрешения на хосте и маршруты в
# ns. Как и sync_ports, вызывается на КАЖДОМ запуске: файл правится руками, а
# адреса у имён меняются.
sync_bypass() {
    local entries addrs a dev devs="" have name ips
    entries=$(bypass_entries)
    addrs=$(printf '%s\n' "$entries" | cut -s -d' ' -f2- | tr ' ' '\n' | grep . | sort -u)

    # 1. хост: цепочка заменяется атомарно (iptables-restore --noflush сбрасывает
    #    объявленную пользовательскую цепочку) — без окна, где ответы уже
    #    установленных соединений падали бы в политику FORWARD.
    {
        echo '*filter'
        echo ":$BYPASS_CHAIN - [0:0]"
        echo "-A $BYPASS_CHAIN -o $VETH_HOST -d $VETH_NS_IP/32 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"
        for a in $addrs; do
            echo "-A $BYPASS_CHAIN -i $VETH_HOST -s $VETH_NS_IP/32 -d $a -j ACCEPT"
        done
        # всё прочее через мостик не форвардим, какой бы ни была политика FORWARD
        echo "-A $BYPASS_CHAIN -j DROP"
        echo 'COMMIT'
    } | iptables-restore --noflush || log "не удалось обновить цепочку $BYPASS_CHAIN"

    if [ -n "$addrs" ]; then
        ensure_forwarding "$VETH_HOST"
        for a in $addrs; do
            dev=$(ip -4 route get "${a%%/*}" 2>/dev/null \
                | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1)
            case " $devs " in *" $dev "*) ;; *) devs="$devs $dev" ;; esac
        done
        for dev in $devs; do
            [ "$dev" = "lo" ] || [ "$dev" = "$VETH_HOST" ] || ensure_forwarding "$dev"
        done
    fi

    # 2. ns: сначала ставим актуальные маршруты, потом снимаем устаревшие —
    #    replace не рвёт уже идущие соединения.
    for a in $addrs; do
        ip netns exec "$NS_NAME" ip route replace "$a" via "$VETH_HOST_IP" \
            dev "$VETH_NS" proto "$BYPASS_PROTO" \
            || log "не удалось поставить маршрут в обход vpn на $a"
    done
    have=$(ip netns exec "$NS_NAME" ip -4 route show proto "$BYPASS_PROTO" \
        | awk '{print $1}')
    for a in $have; do
        printf '%s\n' "$addrs" | grep -qxF "$a" \
            || ip netns exec "$NS_NAME" ip route del "$a" proto "$BYPASS_PROTO"
    done

    # про файл молчим, когда его нет: вывод остаётся прежним
    [ -f "$(hosts_file)" ] || return 0
    while read -r name ips; do
        [ -n "$name" ] || continue
        [ "$name" = "$ips" ] && continue      # адрес как есть — показывать нечего
        if [ -n "$ips" ]; then
            log "в обход vpn: $name -> $ips"
        else
            log "в обход vpn: $name не резолвится — пропускаю"
        fi
    done <<< "$entries"
    log "в обход vpn из $(hosts_file): $(fmt_list "$addrs")"
    return 0
}

# ---------------------- предусловия хостовой сети ----------------------------
# $IFACE уезжает с хоста целиком. Если хостовый аплинк держится на нём же, хост
# останется без маршрута и без DNS (NetworkManager перепишет resolv.conf пустым,
# потому что вместе с устройством уходит и активный профиль). Проверяем это ДО
# переноса — чинить постфактум некому: сети уже нет.

# Устройства, через которые у хоста есть default-маршрут (по одному в строке).
default_route_devs() {
    ip -4 route show default 2>/dev/null \
        | awk '{for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1)}'
}

# То же одной строкой, для вывода человеку.
default_route_devs_str() {
    local devs
    devs=$(default_route_devs | tr '\n' ' ')
    devs=${devs% }
    printf '%s' "${devs:-(нет)}"
}

# Сколько nameserver-строк в хостовом resolv.conf. Отдельная функция, потому что
# 'grep -c' печатает 0 и ПРИ ЭТОМ выходит с кодом 1: наивный '|| echo 0' выдаёт
# два нуля. Фолбэк нужен лишь на отсутствие файла — там вывод пустой.
host_ns_count() {
    local n
    n=$(grep -cE '^[[:space:]]*nameserver' /etc/resolv.conf 2>/dev/null)
    printf '%s' "${n:-0}"
}

# Аплинк хоста НЕ зависит от $IFACE: есть default через другое устройство и есть
# хотя бы один nameserver.
host_uplink_ok() {
    default_route_devs | grep -qvx "$IFACE" || return 1
    grep -qE '^[[:space:]]*nameserver[[:space:]]+[^[:space:]]' \
        /etc/resolv.conf 2>/dev/null
}

# Числовое состояние устройства в NM (10 = unmanaged, 100 = activated).
# LC_ALL=C — текстовые статусы локализованы, по ним матчить нельзя.
nm_dev_state() {
    LC_ALL=C nmcli -t -f GENERAL.STATE device show "$1" 2>/dev/null \
        | sed -n 's/^GENERAL\.STATE:\([0-9]\{1,\}\).*/\1/p'
}

# Ограниченное ожидание готовности хостовой сети. Помогает ровно в одном случае:
# ранний запуск, когда NM ещё не закончил DHCP на хостовом интерфейсе. Устойчиво
# сломанную конфигурацию ожиданием не вылечить — для неё ниже отказ.
wait_for_host_net() {
    host_uplink_ok && return 0
    log "жду готовности хостовой сети (до ${HOST_NET_WAIT}s)"
    command -v nm-online >/dev/null 2>&1 \
        && nm-online -s -q -t "$HOST_NET_WAIT" >/dev/null 2>&1
    # nm-online отпускает по завершении старта NM, маршрут и resolv.conf могут
    # появиться на доли секунды позже — дожимаем опросом.
    local deadline=$((SECONDS + HOST_NET_WAIT))
    while ! host_uplink_ok && [ "$SECONDS" -lt "$deadline" ]; do
        sleep 0.5
    done
    host_uplink_ok
}

# Диагностика для отказа: что именно не так и как чинить.
host_uplink_hint() {
    cat <<EOF
хостовая сеть держится на $IFACE — переносить его в ns нельзя, хост
       останется без маршрута и DNS.
         default-маршрут через: $(default_route_devs_str)
         nameserver в /etc/resolv.conf: $(host_ns_count)
       Ожидание тут не поможет — состояние устойчивое. Подними хостовый
       интерфейс отдельно:
         nmcli device status              # найти хостовый интерфейс
         nmcli device connect <iface>     # поднять его
       Частая причина: единственный профиль NetworkManager не привязан к
       интерфейсу и приземлился на $IFACE. Лечится привязкой профиля:
         nmcli connection modify <профиль> connection.interface-name <iface>
       Сознательно забрать $IFACE несмотря на проверку: VPN_FORCE=1 vpn --ensure
EOF
}

# Отдать $IFACE из-под NetworkManager перед переносом: иначе NM держит на нём
# DHCP-транзакцию и лезет настраивать интерфейс параллельно с 'ip link set netns'.
# Настройка runtime-only (сбрасывается при перезагрузке) — постоянный конфиг NM
# намеренно не трогаем, чтобы схема не требовала правки локальных настроек.
release_from_nm() {
    command -v nmcli >/dev/null 2>&1 || return 0
    local state
    state=$(nm_dev_state "$IFACE")
    [ -z "$state" ] && return 0          # NM про интерфейс не знает
    [ "$state" = "10" ] && return 0      # уже unmanaged
    log "убираю $IFACE из-под NetworkManager (runtime, до перезагрузки)"
    nmcli device set "$IFACE" managed no >/dev/null 2>&1 || return 0
    # NM гасит соединение асинхронно; дожидаемся, иначе он успеет дёрнуть
    # интерфейс уже после переноса.
    local deadline=$((SECONDS + 5))
    while [ "$(nm_dev_state "$IFACE")" != "10" ] && [ "$SECONDS" -lt "$deadline" ]
    do
        sleep 0.3
    done
}

# ------------------------- идемпотентная настройка ---------------------------
ensure_setup() {
    is_root || die "ensure_setup должен выполняться от root"
    # системный PATH только для привилегированной настройки (ip в /usr/sbin).
    # local не трогает окружение, которое позже уедет в пользовательскую команду.
    local PATH="/usr/sbin:/sbin:/usr/bin:/bin:${PATH}"

    if is_ready; then
        sync_ports   # всё создано ранее, но набор портов мог смениться
        sync_bypass  # ...как и список хостов в обход vpn
        return 0
    fi

    # 1. неймспейс. Проверяем РАБОТОСПОСОБНОСТЬ (setns), а не просто наличие имени:
    #    битая ссылка /run/netns/$NS_NAME (пустой файл без nsfs-привязки) тоже
    #    попадает в `ip netns list`, поэтому grep ненадёжен. Если ns битый —
    #    сносим и пересоздаём (физический интерфейс при удалении ns сам
    #    возвращается в основной неймспейс).
    if ip netns list 2>/dev/null | grep -qw "$NS_NAME" && ! ns_usable; then
        log "ns $NS_NAME битый — пересоздаю"
        ip netns delete "$NS_NAME" 2>/dev/null || true
        sleep 0.3
    fi
    if ! ns_usable; then
        log "Создаю неймспейс $NS_NAME"
        ip netns add "$NS_NAME" || die "не удалось создать ns $NS_NAME"
    fi

    # 2. физический интерфейс: переносим внутрь ns, если он ещё на хосте.
    #    Проверка предусловия — только здесь: если $IFACE уже в ns, забирать
    #    нечего и хостовой сети ничто не угрожает.
    if ! iface_in_ns; then
        iface_on_host || die "интерфейс $IFACE не найден ни на хосте, ни в ns $NS_NAME"
        if [ "${VPN_FORCE:-}" != "1" ]; then
            wait_for_host_net || die "$(host_uplink_hint)"
        fi
        release_from_nm
        log "Переношу $IFACE в ns $NS_NAME"
        ip link set "$IFACE" netns "$NS_NAME" \
            || die "не удалось перенести $IFACE в ns (интерфейс занят NetworkManager?)"
    fi

    # 3. адрес, поднятие, дефолтный маршрут внутри ns
    log "Настраиваю сеть в ns: $IFACE $NS_IP/$NS_PREFIX, шлюз $NS_GW"
    ip netns exec "$NS_NAME" ip link set lo up
    ip netns exec "$NS_NAME" ip addr replace "$NS_IP/$NS_PREFIX" dev "$IFACE"
    ip netns exec "$NS_NAME" ip link set "$IFACE" up
    ip netns exec "$NS_NAME" ip route replace default via "$NS_GW" dev "$IFACE" \
        || die "не удалось поставить дефолтный маршрут через $NS_GW"

    # 4. DNS внутри ns (бинд-маунтится поверх /etc/resolv.conf в 'ip netns exec')
    mkdir -p "/etc/netns/$NS_NAME"
    printf 'nameserver %s\nnameserver %s\n' "$DNS1" "$DNS2" \
        > "/etc/netns/$NS_NAME/resolv.conf"

    # 5. veth-пара мостика (создаём, только если нет ни одного конца)
    if ! veth_host_up && ! veth_ns_up; then
        log "Создаю veth $VETH_HOST <-> $VETH_NS"
        ip link add "$VETH_HOST" type veth peer name "$VETH_NS"
    fi
    # ns-конец мог остаться на хосте (например, после сбоя на прошлом запуске)
    if ip link show "$VETH_NS" >/dev/null 2>&1; then
        ip link set "$VETH_NS" netns "$NS_NAME"
    fi

    # 6. хостовый конец. route_localnet ставим ТОЛЬКО на этот интерфейс, а не в
    #    conf/all — иначе петля хоста становится маршрутизируемой отовсюду.
    ip addr replace "$VETH_HOST_IP/$VETH_PREFIX" dev "$VETH_HOST"
    ip link set "$VETH_HOST" up
    echo 1 > "/proc/sys/net/ipv4/conf/$VETH_HOST/route_localnet"

    # 7. ns-конец (route_localnet нужен и здесь: обратный пакет после un-SNAT
    #    получает dst=127.0.0.1 на не-lo интерфейсе)
    ip netns exec "$NS_NAME" ip addr replace "$VETH_NS_IP/$VETH_PREFIX" dev "$VETH_NS"
    ip netns exec "$NS_NAME" ip link set "$VETH_NS" up
    ip netns exec "$NS_NAME" sh -c \
        "echo 1 > /proc/sys/net/ipv4/conf/$VETH_NS/route_localnet"

    # 8. цепочки под пробрасываемые порты и переходы в них. Сами правила наполняет
    #    sync_ports ниже. Хостовый переход вставляем первым: в PREROUTING
    #    уже может сидеть DOCKER, и до него дело доходить не должно.
    iptables -t nat -N "$PORT_CHAIN" 2>/dev/null || true
    ns_ipt   -t nat -N "$PORT_CHAIN" 2>/dev/null || true
    ensure_rule iptables nat -I PREROUTING "${HOST_JUMP_SPEC[@]}"
    ensure_rule ns_ipt   nat -A OUTPUT     "${NS_JUMP_SPEC[@]}"

    #    NS: приложение могло явно забиндить исходящий сокет на 127.0.0.1 —
    #    переписываем источник, иначе пакет уйдёт с невалидным для veth адресом
    ensure_rule ns_ipt nat -A POSTROUTING "${NS_SNAT_SPEC[@]}"

    #    NS: транзит в мостик запрещён — чтобы соседи по VPN-сети не смогли
    #    достучаться до хостовой петли через ns, если кто-то включит ip_forward
    ns_ipt -C FORWARD "${NS_FWD_DROP_SPEC[@]}" 2>/dev/null \
        || ns_ipt -I FORWARD 1 "${NS_FWD_DROP_SPEC[@]}"

    # Мостик только IPv4: ядро не доставляет пакеты на ::1, пришедшие не с lo,
    # и аналога route_localnet для IPv6 нет — хостовую петлю по ::1 не пробросить.
    # Клиентам это не мешает: на ::1 внутри ns прилетает мгновенный ECONNREFUSED
    # от локальной петли ns, после чего они переходят на 127.0.0.1.

    # /etc/hosts намеренно не трогаем: в ns виден настоящий хостовый файл.
    # Нужны ns-специфичные записи — положи /etc/netns/$NS_NAME/hosts руками.

    # 9. обход vpn: хост форвардит из мостика (что именно — решает $BYPASS_CHAIN,
    #    её наполняет sync_bypass) и маскирует ns-адрес на выходе. Переходы в
    #    FORWARD вставляем первыми: у docker политика FORWARD — DROP.
    iptables -N "$BYPASS_CHAIN" 2>/dev/null || true
    ensure_rule iptables filter -I FORWARD     "${HOST_BYPASS_IN_SPEC[@]}"
    ensure_rule iptables filter -I FORWARD     "${HOST_BYPASS_OUT_SPEC[@]}"
    ensure_rule iptables nat    -A POSTROUTING "${HOST_MASQ_SPEC[@]}"

    is_ready || die "настройка не завершилась, смотри 'vpn --status'"
    sync_ports
    sync_bypass
}

# --------------------------------- снос --------------------------------------
# Снять все хостовые правила цепочки "$2" таблицы "$1", в которых grep (аргументы
# после второго) находит совпадение.
del_rules_matching() {
    local table="$1" chain="$2" rule; shift 2
    while read -r rule; do
        [ -n "$rule" ] || continue
        # shellcheck disable=SC2086  # спецификация правила должна разбиться на слова
        iptables -t "$table" -D "$chain" ${rule#"-A $chain "} 2>/dev/null || true
    done < <(iptables -t "$table" -S "$chain" 2>/dev/null | grep "$@")
}

do_clean() {
    is_root || die "do_clean должен выполняться от root"
    local PATH="/usr/sbin:/sbin:/usr/bin:/bin:${PATH}"
    log "Сношу ns $NS_NAME"
    # Хостовая часть мостика. Снимаем ВСЕ правила PREROUTING, ссылающиеся на
    # хостовый конец veth: кроме нашего перехода туда могли попасть правила от
    # прежних версий скрипта. Правила внутри ns уезжают вместе с ним.
    del_rules_matching nat PREROUTING -e "$VETH_HOST_IP" -e " $VETH_HOST "
    # обход vpn: переходы в FORWARD и MASQUERADE
    del_rules_matching filter FORWARD -e " $VETH_HOST "
    del_rules_matching nat POSTROUTING -e "$VETH_NS_IP"
    iptables -t nat -F "$PORT_CHAIN" 2>/dev/null || true
    iptables -t nat -X "$PORT_CHAIN" 2>/dev/null || true
    iptables -F "$BYPASS_CHAIN" 2>/dev/null || true
    iptables -X "$BYPASS_CHAIN" 2>/dev/null || true
    # forwarding на аплинке, если его включал sync_bypass, не выключаем: кроме
    # нас он мог понадобиться кому-то ещё (docker и т.п.)
    ip link del "$VETH_HOST" 2>/dev/null || true   # уносит и $VETH_NS из ns
    # удаление ns автоматически возвращает физический интерфейс в основной ns
    # (без адресов и в состоянии DOWN — хостовая настройка, если она была,
    # восстанавливается средствами NetworkManager/ifupdown).
    ip netns delete "$NS_NAME" 2>/dev/null || true
    rm -rf "/etc/netns/$NS_NAME"
    if iface_on_host; then
        log "$IFACE вернулся на хост (DOWN, без адреса)"
    else
        log "ВНИМАНИЕ: $IFACE не появился на хосте — проверь 'ip link'"
    fi
    log "Готово."
}

# --------------------------------- статус ------------------------------------
do_status() {
    echo "== хостовый аплинк =="
    echo "  default через: $(default_route_devs_str)"
    echo "  nameserver на хосте: $(host_ns_count)"
    if host_uplink_ok; then
        echo "  забирать $IFACE в ns безопасно"
    else
        echo "  ВНИМАНИЕ: хостовая сеть зависит от $IFACE — перенос оставит хост без сети"
    fi
    echo "== неймспейс =="; ip netns list 2>/dev/null | grep -w "$NS_NAME" || echo "  нет"
    echo "== $IFACE =="
    if sudo ip netns exec "$NS_NAME" ip -br addr show dev "$IFACE" 2>/dev/null; then :
    elif ip -br addr show dev "$IFACE" 2>/dev/null; then echo "  (на хосте, не в ns)"
    else echo "  не найден"; fi
    echo "== маршруты в ns =="
    sudo ip netns exec "$NS_NAME" ip route 2>/dev/null || echo "  ns недоступен"
    echo "== DNS в ns =="
    cat "/etc/netns/$NS_NAME/resolv.conf" 2>/dev/null || echo "  нет resolv.conf"
    echo "== мостик к петле хоста =="
    ip -br addr show dev "$VETH_HOST" 2>/dev/null || echo "  $VETH_HOST не поднят"
    sudo ip netns exec "$NS_NAME" ip -br addr show dev "$VETH_NS" 2>/dev/null \
        || echo "  $VETH_NS не поднят"
    echo "  route_localnet($VETH_HOST): $(cat "/proc/sys/net/ipv4/conf/$VETH_HOST/route_localnet" 2>/dev/null || echo '?')"
    echo "== пробрасываемые порты =="
    echo "  lock-файлы IDE ($(ide_lock_dir)): $(fmt_list "$(ide_ports)")"
    if [ -f "$(ports_file)" ]; then
        echo "  список ($(ports_file)): $(fmt_list "$(extra_ports 2>/dev/null)")"
    else
        echo "  список ($(ports_file)): файла нет"
    fi
    echo "  правила в ns:"
    sudo ip netns exec "$NS_NAME" iptables -t nat -S "$PORT_CHAIN" 2>/dev/null \
        | sed -n 's/^-A /    /p' | grep . || echo "    нет"
    echo "  правила на хосте:"
    sudo iptables -t nat -S "$PORT_CHAIN" 2>/dev/null \
        | sed -n 's/^-A /    /p' | grep . || echo "    нет"
    echo "== в обход vpn =="
    if [ -f "$(hosts_file)" ]; then
        echo "  список ($(hosts_file)):"
        bypass_entries 2>/dev/null | while read -r name ips; do
            echo "    $name: ${ips:-не резолвится}"
        done | grep . || echo "    пусто"
    else
        echo "  список ($(hosts_file)): файла нет"
    fi
    echo "  маршруты в ns:"
    sudo ip netns exec "$NS_NAME" ip -4 route show proto "$BYPASS_PROTO" 2>/dev/null \
        | sed 's/^/    /' | grep . || echo "    нет"
    echo "  правила на хосте:"
    sudo iptables -S "$BYPASS_CHAIN" 2>/dev/null \
        | sed -n 's/^-A /    /p' | grep . || echo "    нет"
}

# --------------------------------- проверка ----------------------------------
# Сравниваем внешний IP "как есть" (в том ns, откуда запустили --check) и через
# vpn. Запускается ДО переключения ns в main, поэтому первый curl честно
# показывает адрес исходного неймспейса.
do_check() {
    local URL="https://api.ipify.org"
    local CURL=(curl -fsS -4 --max-time 15 "$URL")

    echo "== внешний IP в текущем ns (без vpn) =="
    if "${CURL[@]}"; then echo; else echo "  (не удалось получить)"; fi

    echo "== внешний IP через vpn =="
    if "$0" "${CURL[@]}"; then echo; else echo "  (не удалось получить)"; fi
}

# --------------------------- выполнение команды ------------------------------
# Внутри ns: окружение и cwd уже унаследованы — просто запускаем команду.
run_here() {
    [ $# -ge 1 ] || die "нужна команда"
    exec "$@"
}

# На хосте: довести окружение до готовности и войти в ns под нужным юзером.
run_via_ns() {
    [ $# -ge 1 ] || { echo "Использование: vpn <команда> [аргументы...]" >&2; exit 1; }

    if is_root; then ensure_setup; else sudo "$0" --ensure || exit 1; fi

    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        USER_TO_RUN="$SUDO_USER"
    else
        USER_TO_RUN="${USER:-$(id -un)}"
    fi

    # Захватываем окружение (исключаем системные переменные, которые нельзя
    # переопределять). Флага -i у внутреннего sudo нет: окружение восстанавливаем
    # руками через eval.
    SAVED_ENV=$(export -p | grep -vE ' (UID|EUID|PPID|SUDO_.*|BASH_.*)=')

    sudo ip netns exec "$NS_NAME" sudo -u "$USER_TO_RUN" bash -c '
        eval "$1"
        cd "$2"
        shift 2
        "$@"
    ' -- "$SAVED_ENV" "$PWD" "$@"
}

# Переключиться в основной (хостовый) сетевой неймспейс, сохранив окружение,
# рабочий каталог и исходного пользователя (через SUDO_USER, который выставит sudo).
# Нужно, когда vpn запущен из чужого ns (например, 'vpn2' из setup/vpn-via-socks):
# вся настройка (перенос $IFACE, маршруты) делается из основного ns хоста.
switch_to_host() {
    local saved_env
    saved_env=$(export -p | grep -vE ' (UID|EUID|PPID|SUDO_.*|BASH_.*)=')
    # -m -n: входим и в mount-ns, и в net-ns PID 1. mount-ns обязателен, т.к.
    # именованные сетевые ns — это бинд-маунты в /run/netns, и в приватном
    # mount-ns вызывающего ссылка на vpn невалидна ("setting the network
    # namespace vpn failed"). Заодно возвращается хостовый /etc/resolv.conf.
    exec sudo nsenter -t 1 -m -n bash -c '
        eval "$1"
        cd "$2"
        shift 2
        exec "$@"
    ' -- "$saved_env" "$PWD" "$0" "$@"
}

# ---------------------------------- main -------------------------------------

# 0) --check обрабатываем ДО любого переключения ns: первый curl должен идти из
#    того неймспейса, откуда вызвали.
if [ "${1:-}" = "--check" ]; then
    do_check
    exit $?
fi

# 1) Уже внутри vpn-ns (в т.ч. вложенный вызов vpn vpn ...).
#    Управляющие флаги требуют основного ns хоста (в приватном mount-ns изнутри
#    ns ссылки /run/netns невалидны, да и настраивать надо снаружи) — уходим туда.
#    Всё остальное выполняем прямо здесь: окружение унаследовано напрямую.
if in_target_ns; then
    case "${1:-}" in
        --ensure|--clean|--status) switch_to_host "$@" ;;
        *)                         run_here "$@" ;;
    esac
fi

# 2) Запущены из другого сетевого ns (например, 'socks') — уходим в основной ns хоста.
CUR_NS="$(ip netns identify $$ 2>/dev/null || true)"
if [ -n "$CUR_NS" ] && [ "$CUR_NS" != "$NS_NAME" ]; then
    switch_to_host "$@"
fi

# 3) Мы в основном ns хоста.
case "${1:-}" in
    --ensure) if is_root; then ensure_setup; else exec sudo "$0" --ensure; fi ;;
    --clean)  if is_root; then do_clean;     else exec sudo "$0" --clean;  fi ;;
    --status) do_status ;;
    "")       echo "Использование: vpn <команда> [аргументы...] | --ensure | --clean | --status | --check" >&2; exit 1 ;;
    *)        run_via_ns "$@" ;;
esac
